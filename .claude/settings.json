{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make help)",
      "Bash(make setup)",
      "Bash(make dev)",
      "Bash(make fmt)",
      "Bash(make lint)",
      "Bash(make lint-debt)",
      "Bash(make typecheck)",
      "Bash(make test-unit)",
      "Bash(make test-hooks)",
      "Bash(make test-fast)",
      "Bash(make test)",
      "Bash(make build)",
      "Bash(make check-fast)",
      "Bash(make check)",
      "Bash(make audit)",
      "Bash(make secrets)",
      "Bash(npm run dev)",
      "Bash(npm run check)",
      "Bash(npm run build)",
      "Bash(npm ls *)",
      "Bash(npm view *)",
      "Bash(npm audit *)",
      "Bash(npx vitest run *)",
      "Bash(npx biome check *)",
      "Bash(npx biome lint *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": ["Bash(git push *)", "Bash(npm install *)", "Bash(npm uninstall *)", "Bash(ssh *)"],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./secrets/**)",
      "Bash(npm run db:push)",
      "Bash(npm run db:push *)",
      "Bash(npx drizzle-kit push *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main)",
      "Bash(git commit --no-verify *)",
      "Bash(sudo *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session_start.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre_bash_guard.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/pre_file_guard.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/post_edit_lint.py",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hooks/stop_check.py",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
